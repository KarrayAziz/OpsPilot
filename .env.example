# Application settings. These values are for local development only.
OPSPILOT_APP_NAME=OpsPilot
OPSPILOT_ENVIRONMENT=development
OPSPILOT_LOG_LEVEL=INFO
OPSPILOT_DATABASE_URL=postgresql+psycopg://opspilot:opspilot@localhost:5432/opspilot
OPSPILOT_QDRANT_URL=http://localhost:6333
OPSPILOT_READINESS_TIMEOUT_SECONDS=2.0

# Docker Compose PostgreSQL bootstrap settings. Replace these outside local development.
POSTGRES_DB=opspilot
POSTGRES_USER=opspilot
POSTGRES_PASSWORD=opspilot
POSTGRES_PORT=5432
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
